{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 120,
  "singleQuote": true,
  "trailingComma": "es5",
  "quoteProps": "preserve",
  "ignorePatterns": [
    "static/**",
    "docs/**",
    "**/*.md",
    "**/*.html",
    "**/*.css",
    "**/*.json",
    "**/*.yml",
    "**/*.yaml"
  ]
}
