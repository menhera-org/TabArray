{
  "compilerOptions": {
    "target": "ES2024",
    "lib": [
      "DOM",
      "DOM.Iterable",
      "ES2024"
    ],
    "module": "es2022",
    "sourceMap": true,
    "declaration": false,
    "newLine": "lf",
    "outDir": "./ts-dist/",
    "rootDir": "./src/",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "useDefineForClassFields": false,
    "isolatedModules": true,
    "moduleResolution": "bundler",
    "skipLibCheck": true,
    "allowJs": true,
    "checkJs": false,
    "jsx": "react-jsx",
    "types": [
      "react",
      "react-dom",
      "vite/client"
    ]
  },
  "include": [
    "src/**/*"
  ]
}